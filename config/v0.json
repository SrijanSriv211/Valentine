{
	"dataset": {
		"data_division": 0.8,
		"load_from_file": true,
		"path": "data/email.bin"
	},
	"checkpoints": {
		"path": "bin/c1",
		"interval": 2000,
		"create_checkpoints": true
	},
	"model_hyperparams": {
		"vocab_size": 8192,
		"block_size": 256,
		"n_layer": 2,
		"n_head": 4,
		"n_embd": 64,
		"d_model": 170
	},
	"optimizer_hyperparams": {
		"eps": 1e-8,
		"beta1": 0.9,
		"beta2": 0.99,
		"momentum": 0.95,
		"weight_decay": 0
	},
	"encoder_path": "bin/o8k.bin",
	"init_from": "scratch",
	"compile": true,
	"seed": 18,

	"batch_size": 16,
	"gradient_accumulation_steps": 1,

	"eval_iters": 200,
	"max_iters": 50000,
	"log_interval": 200,
	"eval_interval": 2000,

	"decay_lr": true,
	"warmup_iters": 2500,
	"cooldown_frac": 0.5,
	"learning_rate": 4e-3,
	"lr_decay_iters": 50000,
	"min_learning_rate": 4e-4
}
