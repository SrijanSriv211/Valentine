{
	"dataset": {
		"data_division": 0.8,
		"load_from_file": true,
		"path": "data/shard_0001.bin"
	},
	"checkpoints": {
		"path": "bin/c1",
		"interval": 2000,
		"create_checkpoints": true
	},
	"model_hyperparams": {
		"vocab_size": 512,
		"block_size": 512,
		"n_layer": 16,
		"n_head": 4,
		"n_embd": 64,
		"d_model": 256
	},
	"optimizer_hyperparams": {
		"eps": 1e-8,
		"beta1": 0.9,
		"beta2": 0.95,
		"momentum": 0.95,
		"weight_decay": 1e-3
	},
	"encoder_path": "bin/o512.bin",
	"init_from": "scratch",
	"compile": true,
	"seed": 18,

	"batch_size": 32,
	"gradient_accumulation_steps": 2,

	"eval_iters": 200,
	"max_iters": 50000,
	"log_interval": 200,
	"eval_interval": 2000,

	"decay_lr": true,
	"warmup_iters": 2500,
	"cooldown_frac": 0.2,
	"learning_rate": 1e-3,
	"lr_decay_iters": 50000,
	"min_learning_rate": 1e-4
}
